# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=1234

# 세션 설정
SESSION_SECRET_KEY=your_super_secret_key_change_this_in_production
SESSION_MAX_AGE=3600

# CORS 설정
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 서버 설정
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG_MODE=True

# 파일 업로드 설정
UPLOAD_DIR=./upload
MAX_FILE_SIZE_MB=50
